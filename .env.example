# Local development only. Production values belong in the deployment environment.
DATABASE_URL=file:./data/dev.db
PAYLOAD_SECRET=replace-with-output-from-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Repository root containing content/blog and content/novels.
CONTENT_REPO_ROOT=../waitforit-site-content
# Host path mounted read-only at /content by Docker Compose.
CONTENT_REPO_HOST_PATH=../waitforit-site-content
